# Ollama runs locally by default. Start it with: ollama serve
OLLAMA_HOST=http://localhost:11434

# Fast and good enough for local folder organization.
# For higher quality text matching try: mxbai-embed-large or qwen3-embedding:0.6b
FILE_ORGANIZER_EMBED_MODEL=nomic-embed-text

# Small default that avoids vLLM and runs through Ollama.
# Higher quality swaps: llama3.2-vision:11b, qwen2.5vl:7b, qwen3-vl:8b
FILE_ORGANIZER_VISION_MODEL=moondream

# Optional text model used only for naming new clusters. Leave blank for deterministic names.
FILE_ORGANIZER_NAMING_MODEL=

# Similarity thresholds are cosine similarity over normalized embeddings.
FILE_ORGANIZER_EXISTING_FOLDER_THRESHOLD=0.68
FILE_ORGANIZER_EXISTING_FOLDER_MARGIN=0.06
FILE_ORGANIZER_NEW_CLUSTER_THRESHOLD=0.72
FILE_ORGANIZER_MIN_CLUSTER_SIZE=2

# One of: other, error, leave
FILE_ORGANIZER_UNMATCHED_POLICY=other
FILE_ORGANIZER_OTHER_FOLDER=Other

# Read only this much text from documents.
FILE_ORGANIZER_TEXT_HEAD_CHARS=4000
